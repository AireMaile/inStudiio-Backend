# Supabase
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Stripe — test-mode secret key. Dashboard: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET is used in Plan 3 (webhook handler). Leave blank for now.
STRIPE_WEBHOOK_SECRET=


# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# --- Mux (video hosting) ---
# Create at https://dashboard.mux.com/settings/access-tokens
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# Webhook signing secret: https://dashboard.mux.com/settings/webhooks
MUX_WEBHOOK_SECRET=
# Signing key pair for signed playback URLs: https://dashboard.mux.com/settings/signing-keys
# MUX_SIGNING_PRIVATE_KEY is the base64-encoded private key exactly as Mux provides it.
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=

# Internal maintenance endpoint bearer secret (minimum 16 characters).
# Required in production; store the same value in Supabase Vault for Cron.
CRON_SECRET=

# Origin allowed to PUT direct-upload files to Mux (required in production).
# In dev/test this falls back to "*".
APP_ORIGIN=

# Comma-separated list of allowed CORS origins for cross-origin frontend dev.
# Example: CORS_ORIGINS=http://localhost:5173,http://localhost:3001
# Leave blank in dev — the server allows all origins by default in non-production.
# Required in production.
CORS_ORIGINS=
