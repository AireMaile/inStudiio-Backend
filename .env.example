# Supabase
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Stripe — test-mode secret key. Dashboard: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET is used in Plan 3 (webhook handler). Leave blank for now.
STRIPE_WEBHOOK_SECRET=

# Cloudflare Stream (used later, not in Plan 1)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_KEY_JWK=

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# --- Mux (video hosting) ---
# Create at https://dashboard.mux.com/settings/access-tokens
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# Webhook signing secret: https://dashboard.mux.com/settings/webhooks
MUX_WEBHOOK_SECRET=

# Origin allowed to PUT direct-upload files to Mux (required in production).
# In dev/test this falls back to "*".
APP_ORIGIN=
